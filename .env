# ============================================
# CONFIGURATION SERVEUR - MOBILE OPTIMIZED
# ============================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_URL=http://localhost:3000

# ============================================
# BASE DE DONNÉES - SESSION STORE FOR MOBILE
# ============================================
MONGODB_URI=mongodb://localhost:27017/aprofeec-mobile
MONGO_SESSION_STORE=mongodb://localhost:27017/aprofeec-sessions
REDIS_URL=redis://localhost:6379  # Optionnel pour cache mobile

# ============================================
# SÉCURITÉ & AUTHENTIFICATION
# ============================================
JWT_SECRET=votre_super_secret_jwt_pour_la_production_changez_moi
JWT_REFRESH_SECRET=refresh_secret_pour_mobile_apps_changez_moi
JWT_EXPIRES_IN=15m  # Court pour mobile
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=cookie_secret_pour_sessions_mobile_changez_moi

# ============================================
# CORS - MOBILE & MULTI-DEVICES
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,capacitor://localhost,ionic://localhost
CORS_MOBILE_ORIGINS=http://localhost:19006,exp://192.168.1.*:19000
CORS_CREDENTIALS=true

# ============================================
# PWA - PROGRESSIVE WEB APP
# ============================================
PWA_NAME=APROFEEC Mobile
PWA_SHORT_NAME=APROFEEC
PWA_THEME_COLOR=#1e40af
PWA_BACKGROUND_COLOR=#ffffff
PWA_DISPLAY=standalone
PWA_START_URL=/
PWA_SCOPE=/
PWA_ORIENTATION=portrait

# ============================================
# EMAIL - MOBILE NOTIFICATIONS
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@aprofeec.org
SMTP_PASS=votre_mot_de_passe_smtp
EMAIL_FROM=APROFEEC <contact@aprofeec.org>
EMAIL_REPLY_TO=support@aprofeec.org

# ============================================
# UPLOAD - OPTIMISÉ MOBILE
# ============================================
MAX_FILE_SIZE=10485760  # 10MB
MAX_IMAGE_SIZE=5242880  # 5MB pour mobile
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_PATH=./public/uploads
CDN_URL=http://localhost:3000/uploads

# ============================================
# PERFORMANCE MOBILE
# ============================================
MOBILE_CACHE_TIME=3600  # 1 heure en secondes
DESKTOP_CACHE_TIME=86400  # 24 heures
COMPRESSION_LEVEL=6
RATE_LIMIT_WINDOW=15  # minutes
RATE_LIMIT_MAX=100
RATE_LIMIT_MOBILE=50  # Moins de requêtes pour mobile

# ============================================
# PUSH NOTIFICATIONS - MOBILE
# ============================================
FCM_SERVER_KEY=votre_cle_firebase_cloud_messaging
VAPID_PUBLIC_KEY=votre_cle_vapid_publique
VAPID_PRIVATE_KEY=votre_cle_vapid_privee

# ============================================
# ANALYTICS & MONITORING
# ============================================
SENTRY_DSN=votre_dsn_sentry
GOOGLE_ANALYTICS_ID=UA-XXXXX-Y
HOTJAR_ID=votre_id_hotjar

# ============================================
# FRONTEND & URLs
# ============================================
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin-panel
MOBILE_DEEP_LINK=aprofeec://
APP_STORE_URL=https://apps.apple.com/app/idXXXXXX
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=org.aprofeec

# ============================================
# WEBSOCKET - REAL-TIME MOBILE
# ============================================
WS_PORT=3001
WS_PATH=/socket.io
WS_PING_TIMEOUT=60000  # 1 minute pour mobile
WS_PING_INTERVAL=25000
WS_MAX_PAYLOAD=1048576  # 1MB

# ============================================
# ENVIRONMENT SPECIFIC
# ============================================
# Développement
if [ "$NODE_ENV" = "development" ]; then
  DEBUG=true
  LOG_LEVEL=debug
  CACHE_ENABLED=false
fi

# Production
if [ "$NODE_ENV" = "production" ]; then
  DEBUG=false
  LOG_LEVEL=warn
  CACHE_ENABLED=true
  SECURE_COOKIES=true
  HTTPS_ONLY=true
fi